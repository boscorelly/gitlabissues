msgstr "Merge request(s) de clôture :"

#: src/Sync.php
msgid "The GitLab issue %s was moved to another project. It is not followed anymore: the ticket is left unchanged."
msgstr "L'issue GitLab %s a été déplacée vers un autre projet. Elle n'est plus suivie : le ticket reste inchangé."

#: templates/config.html.twig
msgid "GitLab Issues"
msgstr "Issues GitLab"

#: templates/config.html.twig
msgid "GitLab connection"
msgstr "Connexion à GitLab"

#: templates/config.html.twig
