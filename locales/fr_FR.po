#: src/Controller/ConfigController.php
msgid "The GitLab URL must start with http:// or https://"
msgstr "L'URL GitLab doit commencer par http:// ou https://"

#: src/Controller/ConfigController.php
msgid "Settings saved."
msgstr "Configuration enregistrée."

#: src/Controller/ConfigController.php
msgid "Rights updated."
msgstr "Droits mis à jour."

#: src/Controller/ConfigController.php
msgid "Connection successful: GitLab %1$s, authenticated as %2$s."
msgstr "Connexion réussie : GitLab %1$s, authentifié en tant que %2$s."

#: src/Controller/ConfigController.php
msgid "This token has no \"api\" scope: it can read issues but not create them."
msgstr "Ce jeton n'a pas le périmètre « api » : il peut lire les issues mais pas en créer."

