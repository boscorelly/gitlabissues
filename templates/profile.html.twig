<div class="card m-3">
    <div class="card-header"><h3 class="card-title">{{ __('GitLab issues', 'gitlabissues') }}</h3></div>
    <form method="post" action="{{ base }}/Profile/{{ profile_id }}/Rights">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        <div class="card-body">
            {% for right in rights %}
                <label class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="rights[]" value="{{ right.value }}"
                           {{ right.checked ? 'checked' : '' }} {{ can_edit ? '' : 'disabled' }}>
                    <span class="form-check-label">{{ right.label }}</span>
                </label>
            {% endfor %}
        </div>
        {% if can_edit %}
            <div class="card-footer"><button type="submit" class="btn btn-primary">{{ __('Save') }}</button></div>
        {% endif %}
    </form>
</div>
