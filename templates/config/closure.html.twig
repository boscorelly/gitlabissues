<form method="post" action="{{ form_url }}" class="m-3">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="_tab" value="closure">
    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">{{ __('When the issue is closed on GitLab', 'gitlabissues') }}</h3></div>
        <div class="card-body">
            <h4 class="mb-2">{{ __('For technicians', 'gitlabissues') }}</h4>
            <label class="form-check"><input class="form-check-input" type="checkbox" name="close_followup" value="1" {{ settings.close_followup == '1' ? 'checked' }}><span class="form-check-label">{{ __('Add a followup with the GitLab details (who closed the issue, when, merge requests)', 'gitlabissues') }}</span></label>
            <label class="form-check ms-4 mb-3"><input class="form-check-input" type="checkbox" name="close_followup_private" value="1" {{ settings.close_followup_private == '1' ? 'checked' }}><span class="form-check-label">{{ __('Private followup', 'gitlabissues') }}</span></label>

            <h4 class="mb-2">{{ __('For the requester', 'gitlabissues') }}</h4>
            <p class="text-muted">{{ __('Requesters, who are often not technicians, never see the GitLab tab. These neutral public messages tell them that their request was forwarded and completed, without any GitLab detail (project, developer, link). GLPI notifications apply to public followups.', 'gitlabissues') }}</p>
            <label class="form-check"><input class="form-check-input" type="radio" name="requester_close_mode" value="none" {{ close_mode == 'none' ? 'checked' }}><span class="form-check-label">{{ __('Nothing', 'gitlabissues') }}</span></label>
            <label class="form-check"><input class="form-check-input" type="radio" name="requester_close_mode" value="followup" {{ close_mode == 'followup' ? 'checked' }}><span class="form-check-label">{{ __('A public followup with the message below', 'gitlabissues') }}</span></label>
            <label class="form-check"><input class="form-check-input" type="radio" name="requester_close_mode" value="solve" {{ close_mode == 'solve' ? 'checked' }}><span class="form-check-label">{{ __('The ticket is solved, with the message below as the solution (notifications and automatic actions apply)', 'gitlabissues') }}</span></label>
            <div class="mt-2">
                <label class="form-label">{{ __('Message to the requester', 'gitlabissues') }}</label>
                <textarea name="notify_requester_close_text" class="form-control" rows="2" placeholder="{{ default_notice_close }}">{{ settings.notify_requester_close_text }}</textarea>
                <div class="form-text">{{ __('Plain text. Empty = default message.', 'gitlabissues') }}</div>
            </div>
            <div class="mt-2">
                <label class="form-label">{{ __('Solution type (when the ticket is solved)', 'gitlabissues') }}</label>
                <select name="solutiontypes_id" class="form-select">
                    <option value="0">—</option>
                    {% for id, name in solution_types %}<option value="{{ id }}" {{ settings.solutiontypes_id == id ? 'selected' }}>{{ name }}</option>{% endfor %}
                </select>
            </div>
            <details class="mt-2" {{ settings.solution_template ? 'open' }}>
                <summary class="text-muted">{{ __('Advanced: custom solution text', 'gitlabissues') }}</summary>
                <textarea name="solution_template" class="form-control mt-2" rows="3">{{ settings.solution_template }}</textarea>
                <div class="form-text">{{ __('Optional. Replaces the message above as the text of the solution (HTML allowed). Placeholders: {issue}, {issue_url}, {closed_by}, {closed_at}, {ticket_id}. They show GitLab details to the requester.', 'gitlabissues') }}</div>
            </details>

            <h4 class="mt-4 mb-2">{{ __('Author', 'gitlabissues') }}</h4>
            <label class="form-label">{{ __('Author of the automatic followups and solutions', 'gitlabissues') }}</label>
            <select name="actor_users_id" class="form-select">
                <option value="0">{{ __('The user who created the issue', 'gitlabissues') }}</option>
                {% for id, name in users %}<option value="{{ id }}" {{ settings.actor_users_id == id ? 'selected' }}>{{ name }}</option>{% endfor %}
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">{{ __('Save') }}</button>
</form>
